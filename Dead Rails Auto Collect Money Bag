local WS = (cloneref and cloneref(game:GetService("Workspace")) or game:GetService("Workspace"))
local RS = (cloneref and cloneref(game:GetService("ReplicatedStorage")) or game:GetService("ReplicatedStorage"))

local StoreEvent = RS:WaitForChild("Shared"):WaitForChild("Universe"):WaitForChild("Network"):WaitForChild("RemoteEvent"):WaitForChild("Store")
local ActionableEvent = RS:WaitForChild("Shared"):WaitForChild("Universe"):WaitForChild("Network"):WaitForChild("RemoteEvent"):WaitForChild("Actionable")

local ItemFolder = WS:WaitForChild("ObjectModels")

local function CollectMoneyBag(Obj)
    if Obj:IsA("Model") and Obj.Name == "money_bag" then
        task.wait(0.25)

        local EntityId = Obj:GetAttribute("ServerEntityId")
        if EntityId ~= nil then
            StoreEvent:FireServer(EntityId)
            StoreEvent:FireServer(nil)
            ActionableEvent:FireServer(EntityId)
        end
    end
end

-- Collect money bag yang sudah ada
for _, Obj in pairs(ItemFolder:GetChildren()) do
    CollectMoneyBag(Obj)
end

-- Collect money bag yang baru muncul
ItemFolder.ChildAdded:Connect(function(Obj)
    CollectMoneyBag(Obj)
end)
